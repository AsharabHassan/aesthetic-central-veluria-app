# ─────────────────────────────────────────────────────────────
# Aesthetics Central — Veluria skin-scan funnel
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
#   cp .env.local.example .env.local
#
# Covers every variable this app reads. Anything under "optional" has a
# working code default, shown in its comment — leave it unset to take that.
#
# NOTE: .env.example (no ".local") is a DIFFERENT file for the docker/VPS
# stack — Postgres, MinIO, Caddy. This file is for local Next.js dev.
# ─────────────────────────────────────────────────────────────

# ── Required — the funnel cannot produce a report without these ──

# Anthropic — the written skin analysis (Claude vision)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — the before/after image (gpt-image-2 edits endpoint)
OPENAI_API_KEY=sk-...


# ── CRM + report delivery (optional — flow completes without them) ──

# GoHighLevel inbound webhook URL (Workflows -> Inbound Webhook trigger)
# Leads are POSTed here as JSON before results are revealed.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...

# GoHighLevel Private Integration — uploads the branded PDF report, attaches it
# to the contact (custom field + note) and emails the client a copy via
# /api/report. Both token + location are required to enable delivery; if unset,
# the report step is skipped silently and the flow still completes. A verified
# sending domain must be configured in the GHL sub-account for email to deliver.
# TODO(Aesthetics Central): their own GHL sub-account token.
GHL_API_TOKEN=pit-...
GHL_LOCATION_ID=...
# Bare GHL custom-field key (no "contact." prefix) the report URL is written into.
GHL_REPORT_FIELD_KEY=facial_app_report_pdf


# ── Public URLs and tracking (NEXT_PUBLIC_* ship to the browser) ──

# General clinic website — used for brand links (e.g. the report email signature).
NEXT_PUBLIC_SITE_URL=https://aestheticscentral.co.uk/

# Where the "Book a consultation" button sends users
NEXT_PUBLIC_BOOKING_URL=https://aestheticscentral.co.uk/

# Booking calendar URL for the "Book a Free Consultation" CTA
# (free online phone consultation). Falls back to a default if unset.
# Aesthetics Central's GHL calendar — free Veluria online consultation.
NEXT_PUBLIC_CALENDAR_URL=https://api.leadconnectorhq.com/widget/bookings/free-veluria-online-consultation

# Meta (Facebook) Pixel ID — used for PageView + Lead events and the
# Conversions API fields forwarded to GHL. Leave unset, or set the real
# Aesthetics Central pixel before any campaign.
NEXT_PUBLIC_META_PIXEL_ID=

# How many concern zones the results reel shows. Editorial choice — the reel is
# ordered worst-first, and three unmistakable changes read better than seven
# faint ones. Default: 3
# NEXT_PUBLIC_ZONE_LIMIT=3


# ── Image generation tuning (optional — all have defaults) ──

# Candidates generated per after-image, best-of picked by the verifier. Default: 4
# AFTER_CANDIDATES=4
# Streamed partial images per candidate. Default: 3
# AFTER_PARTIAL_IMAGES=3
# Wall-clock budget for the whole after-image step, ms. The route must finish
# inside the platform's 300s ceiling. Default: 240000
# AFTER_MAX_WAIT_MS=240000
# Quality tier: low | medium | high. Default: medium
# AFTER_QUALITY=medium
# Quality for the one retry when the first pass is rejected. Default: medium
# AFTER_RESCUE_QUALITY=medium
# Post-process strength, 0 disables. Defaults: 2 and 2
# GLOW_STRENGTH=2
# FIRMNESS_STRENGTH=2


# ── Dev/eval only — not needed to run the funnel ──

# Black Forest Labs (FLUX) — used ONLY by tools/eval-kontext.mjs for the
# image-model comparison. The tools read this file directly, not process.env.
BFL_API_KEY=bfl_...
# FLUX sampling, flex models only. Defaults: 50 and 3
# FLUX_STEPS=50
# FLUX_GUIDANCE=3

# Lets a localhost production build run beside an existing dev server without
# sharing or locking the same .next directory. Default: .next
# NEXT_DIST_DIR=.next-prod
